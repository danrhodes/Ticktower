<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light keeps the stock Windows look. Only the keys used by the app's own XAML and code are defined. -->
    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Text" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="BoardBg" Color="#F2F4F6" />
    <SolidColorBrush x:Key="CardBg" Color="White" />
    <SolidColorBrush x:Key="CardBorder" Color="#D0D5DA" />
    <SolidColorBrush x:Key="SubtleText" Color="#666677" />
    <SolidColorBrush x:Key="MutedText" Color="Gray" />
    <SolidColorBrush x:Key="ErrorText" Color="#B00020" />
</ResourceDictionary>
