<Window x:Class="Ticktower.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticktower Board" Width="1000" Height="640" MinWidth="600" MinHeight="300"
        Background="{DynamicResource BoardBg}" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <DataTemplate x:Key="CardTemplate">
            <Border Margin="0,0,0,8" Padding="10" CornerRadius="4" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                <DockPanel>
                  <Border DockPanel.Dock="Left" Width="6" CornerRadius="3" Margin="-4,-4,8,-4" Background="{Binding AccentBrush}" />
                  <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{Binding PriorityBrush}" CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding PriorityText}" Foreground="White" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubtleText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TimeText}" FontSize="30" FontFamily="Consolas" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource SubtleText}" FontSize="11" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Start" Command="{Binding StartCommand}" Visibility="{Binding CanStart, Converter={StaticResource BoolVis}}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Pause" Command="{Binding PauseCommand}" Visibility="{Binding CanPause, Converter={StaticResource BoolVis}}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Lap" Command="{Binding LapCommand}" Visibility="{Binding CanLap, Converter={StaticResource BoolVis}}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Stop" Command="{Binding StopCommand}" Visibility="{Binding CanStop, Converter={StaticResource BoolVis}}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Acknowledge" Command="{Binding AcknowledgeCommand}" Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolVis}}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Snooze…" Command="{Binding SnoozeCommand}" Visibility="{Binding CanSnooze, Converter={StaticResource BoolVis}}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Bookmark" Command="{Binding BookmarkCommand}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Edit" Command="{Binding EditCommand}" />
                        <Button Margin="0,6,4,0" Padding="8,2" Content="Delete" Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <Style TargetType="TextBlock" x:Key="LaneHeader">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Colour by" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="ColourModeBox" Width="110" SelectionChanged="OnColourModeChanged" />
        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="16,0,6,0" />
        <ComboBox x:Name="ThemeBox" Width="80" SelectionChanged="OnThemeChanged" />
        <CheckBox x:Name="AlwaysOnTop" Content="Always on top" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnAlwaysOnTop" />
    </StackPanel>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,5,0">
            <TextBlock x:Name="ActiveHeader" DockPanel.Dock="Top" Style="{StaticResource LaneHeader}" Text="Active" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource CardTemplate}" />
            </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="5,0">
            <TextBlock x:Name="ExpiredHeader" DockPanel.Dock="Top" Style="{StaticResource LaneHeader}" Text="Expired" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ExpiredList" ItemTemplate="{StaticResource CardTemplate}" />
            </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Column="2" Margin="5,0,0,0">
            <TextBlock x:Name="AckHeader" DockPanel.Dock="Top" Style="{StaticResource LaneHeader}" Text="Acknowledged" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AckList" ItemTemplate="{StaticResource CardTemplate}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
