<Window x:Class="Ticktower.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticktower" Topmost="True" SizeToContent="WidthAndHeight" MaxWidth="360"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="6">
        <ItemsControl x:Name="TypeButtons">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}" Margin="3" Padding="12,8" MinWidth="76"
                            Click="OnTypeClick" MouseRightButtonUp="OnTypeRightClick" Tag="{Binding}"
                            ToolTip="{Binding Hotkey}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="PresetLabel" Text="Presets" Foreground="Gray" Margin="4,6,0,0" />
        <ItemsControl x:Name="PresetButtons">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}" Margin="3" Padding="10,5" Click="OnPresetClick" Tag="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="+ Type" Margin="3" Padding="8,3" Click="OnNewType" ToolTip="Add a timer type" />
            <Button Content="Export…" Margin="3" Padding="8,3" Click="OnExport" ToolTip="Export closed timers to CSV" />
            <Button Content="Settings…" Margin="3" Padding="8,3" Click="OnSettings" />
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="#B00020" TextWrapping="Wrap" Margin="4,2,4,0" />
    </StackPanel>
</Window>
