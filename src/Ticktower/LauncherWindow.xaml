<Window x:Class="Ticktower.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticktower" Topmost="True" SizeToContent="WidthAndHeight" MaxWidth="360"
        WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False">
    <ItemsControl x:Name="TypeButtons" Margin="6">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Content="{Binding Name}" Margin="3" Padding="12,8" MinWidth="76"
                        Click="OnTypeClick" Tag="{Binding}" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
